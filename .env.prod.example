# Production env template. Copy to .env.prod and fill before
# `docker compose -f docker-compose.prod.yml --env-file .env.prod up`.

# --- Backend ---
# Generate: python -c "import secrets;print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated, no protocol. Two kinds of hosts to include:
#  1. Public hostname(s) the user's browser hits (if backend is exposed)
#  2. Internal proxy hostname Next.js uses to reach the backend.
#     For this compose file that's literally `backend` because the FE
#     proxies `/api/*` via http://backend:8000.
# Example: thermalos.example,backend
ALLOWED_HOSTS=

# Comma-separated, with protocol. The frontend public URL goes here so
# CORS preflight succeeds for any direct browser→backend call (the rewrite
# proxy in Next.js usually means same-origin, but production CDNs may not).
CORS_ALLOWED_ORIGINS=

# Optional. Without it, /api/chat/ returns the graceful fallback message.
ANTHROPIC_API_KEY=

# Optional. Default 3. Rule of thumb: (2 × CPUs) + 1.
GUNICORN_WORKERS=3

# --- Frontend ---
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# The public URL the browser hits. Must match the cookie domain — if you
# expose the frontend at https://thermalos.example, this is exactly that.
NEXTAUTH_URL=

# --- Database ---
POSTGRES_USER=thermalos
POSTGRES_DB=thermalos
# Anything but the dev value. 32+ chars random recommended.
POSTGRES_PASSWORD=

# --- Host port ---
FRONTEND_PORT=3000
